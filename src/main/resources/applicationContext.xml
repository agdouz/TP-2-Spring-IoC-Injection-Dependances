<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Déclaration explicite des beans pour la configuration XML -->
    <bean id="dao" class="dao.DaoImpl" />
    <bean id="dao2" class="dao.DaoImpl2" />

    <!-- Injection de dépendance via le setter setDao -->
    <bean id="metier" class="metier.MetierImpl">
        <property name="dao" ref="dao" />
    </bean>

    <!-- Variante avec dao2 -->
    <bean id="metierDev" class="metier.MetierImpl">
        <property name="dao" ref="dao2" />
    </bean>
</beans>
